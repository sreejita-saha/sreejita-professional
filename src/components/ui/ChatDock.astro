---
import './ChatDock.css';
---
<div class="chat-dock" id="portfolio-chat">
  <section class="chat-dock__panel" id="chat-panel" aria-label="Portfolio assistant" hidden>
    <div class="chat-dock__heading">
      <div><span>PORTFOLIO ASSISTANT</span></div>
      <button class="chat-dock__close" type="button" aria-label="Close chat">×</button>
    </div>
    <div class="chat-dock__messages" aria-live="polite" aria-relevant="additions text">
      <p class="chat-dock__message chat-dock__message--assistant">Hi! I am Sreejita, your portfolio assistant. You can ask me about my projects, experience, education or skills.</p>
    </div>
  </section>
  <form class="chat-dock__input-wrap">
    <input id="portfolio-question" aria-label="Ask about my work" type="text" placeholder="Ask about my work..." autocomplete="off" maxlength="200" required />
    <button class="chat-dock__send" type="submit" aria-label="Send message">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </form>
</div>
<script>
  const dock = document.querySelector<HTMLElement>('#portfolio-chat');
  const panel = dock?.querySelector<HTMLElement>('#chat-panel');
  const form = dock?.querySelector<HTMLFormElement>('form');
  const input = dock?.querySelector<HTMLInputElement>('input');
  const send = dock?.querySelector<HTMLButtonElement>('.chat-dock__send');
  const messages = dock?.querySelector<HTMLElement>('.chat-dock__messages');
  function addMessage(text: string, role: 'visitor' | 'assistant') {
    const message = document.createElement('p');
    message.className = `chat-dock__message chat-dock__message--${role}`;
    message.textContent = text;
    messages?.append(message);
    message.scrollIntoView({ block: 'nearest' });
    return message;
  }
  dock?.querySelector<HTMLButtonElement>('.chat-dock__close')?.addEventListener('click', () => {
    if (panel) panel.hidden = true;
  });
  input?.addEventListener('focus', () => { if (panel) panel.hidden = false; });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const question = input?.value.trim();
    if (!question || !input || !send || !panel) return;
    panel.hidden = false;
    addMessage(question, 'visitor');
    input.value = '';
    input.disabled = true;
    send.disabled = true;
    const pending = addMessage('Thinking…', 'assistant');
    try {
      const response = await fetch('/api/chat', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ question }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
      pending.textContent = data.answer;
      if (Array.isArray(data.sources) && data.sources.length) {
        const sources = document.createElement('small');
        sources.className = 'chat-dock__sources';
        sources.textContent = `Sources: ${[...new Set(data.sources.map((source: { title: string }) => source.title))].join(', ')}`;
        pending.append(sources);
      }
    } catch (error) {
      pending.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
    } finally {
      input.disabled = false;
      send.disabled = false;
      messages?.scrollTo({ top: messages.scrollHeight });
    }
  });
</script>
