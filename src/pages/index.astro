---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ChatDock from '../components/ui/ChatDock.astro';
import About from '../features/home/sections/About.astro';
import Experience from '../features/home/sections/Experience.astro';
import Education from '../features/home/sections/Education.astro';
import Skills from '../features/home/sections/Skills.astro';
import Contact from '../features/home/sections/Contact.astro';
import Hero from '../features/home/sections/Hero.astro';
import Projects from '../features/home/sections/Projects.astro';
import '../styles/global.css';
---

<Layout>
  <div class="loader" aria-hidden="true">
    <div class="loader-top"><span>SJ / 2026</span><span>Portfolio 01</span></div>
    <div class="loader-center"><b>SJ</b><span>Sreejita</span></div>
    <div class="loader-bottom"><span>Loading a thoughtful interface</span><span class="percent">00%</span></div>
    <div class="loader-line"><i></i></div>
  </div>

  <div class="site">
    <SiteHeader />
    <main id="top">
      <Hero />
      <About />
      <Experience />
      <Education />
      <Projects />
      <Skills />
      <Contact />
    </main>
  </div>

  <ChatDock />

  <script src="../features/home/scripts/index.ts"></script>
</Layout>

