---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/portfolio/AboutSection.astro';
import CapabilitiesSection from '../components/portfolio/CapabilitiesSection.astro';
import ContactSection from '../components/portfolio/ContactSection.astro';
import HeroSection from '../components/portfolio/HeroSection.astro';
import SiteHeader from '../components/portfolio/SiteHeader.astro';
import WorkSection from '../components/portfolio/WorkSection.astro';
import { capabilities, projects } from '../data/portfolio';
import '../styles/global.css';
---

<Layout>
  <div class="loader" aria-hidden="true">
    <div class="loader-top"><span>SJ / 2026</span><span>Portfolio 01</span></div>
    <div class="loader-center"><b>SJ</b><span>Sreejita</span></div>
    <div class="loader-bottom"><span>Loading a thoughtful interface</span><span class="percent">00%</span></div>
    <div class="loader-line"><i></i></div>
  </div>

  <div class="site">
    <SiteHeader />
    <main id="top">
      <HeroSection />
      <AboutSection />
      <WorkSection projects={projects} />
      <CapabilitiesSection capabilities={capabilities} />
      <ContactSection />
    </main>
  </div>

  <script src="../scripts/portfolio.ts"></script>
</Layout>
