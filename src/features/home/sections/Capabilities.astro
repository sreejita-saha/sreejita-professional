---
import Section from '../../../components/ui/Section.astro';
import { capabilities } from '../data';
---
<Section class="capabilities" id="capabilities">
  <div class="index">06 / TOOLKIT</div>
  <div class="cap-body">
    <p class="label">Languages, frameworks and platforms</p>
    <h2>Skills &amp; tools<span>.</span></h2>
    <p class="toolkit-intro">A selection of the languages, frameworks and platforms I’ve used across university, internships and personal projects.</p>
    <div class="cap-list">
      {capabilities.map((capability) => <div><small>{capability.number}</small><b>{capability.title}</b><p>{capability.description}</p></div>)}
    </div>
  </div>
</Section>
