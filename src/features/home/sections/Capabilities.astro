---
import type { Capability } from '../data';
import Section from '../../../components/ui/Section.astro';

interface Props { capabilities: Capability[] }
const { capabilities } = Astro.props;
---

<!-- Homepage capabilities section. -->
<Section class="capabilities" id="capabilities">
  <div class="index">04 / CAPABILITIES</div>
  <div class="cap-body">
    <h2 class="reveal">Good work sits<br /><span>in the details.</span></h2>
    <div class="cap-list reveal">
      {capabilities.map((capability) => <div><small>{capability.number}</small><b>{capability.title}</b><p>{capability.description}</p></div>)}
    </div>
  </div>
</Section>
