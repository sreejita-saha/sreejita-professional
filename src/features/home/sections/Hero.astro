---
import HeroIntroduction from './HeroIntroduction.astro';
---
<section class="hero">
  <div class="hero-heading">
    <HeroIntroduction />
    <h1 class="hero-wordmark">
    <img src="/sreejita.svg" alt="Sreejita" />
    </h1>
  </div>

  <div class="hero-bottom" id="about">
    <div class="hero-bottom__label"><span>01 / INTRODUCTION</span><span>SOFTWARE ENGINEERING<br />&amp; CREATIVE DEVELOPMENT</span></div>
    <div class="hero-manifesto">
      <h2>Ideas into code.<br /><span>Curiosity into something real.</span></h2>
      <p>Explore a selection of projects spanning secure systems, connected hardware and interactive experiences.</p>
      <a href="#work">Explore my projects <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>


