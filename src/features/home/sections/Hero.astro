---
import HeroIntroduction from './HeroIntroduction.astro';
---
<section class="hero">
  <div class="hero-heading">
    <HeroIntroduction />
    <h1 class="hero-wordmark">
    <img src="/sreejita.svg" alt="Sreejita" />
    </h1>
  </div>

  <div class="hero-bottom" id="about">
    <div class="hero-stat">
      <div class="stat-meta"><span>&larr; &rarr;</span><span>01/02</span></div>
      <strong>04+</strong>
      <p>Years turning ideas into dependable digital products.</p>
    </div>
    <div class="hero-manifesto">
      <p>I care about products that make complex things feel obvious. The work is visual, technical, and built to earn trust.</p>
      <p>Good design makes space for people to understand what matters. Good engineering makes sure it stays that way.</p>
      <div class="signature"><span>SJ</span><small>Sreejita<br />Software engineer</small></div>
    </div>
  </div>
</section>


