---
import { ArrowUp, ArrowUpRight, Download } from 'lucide-astro';
import Section from '../../../components/ui/Section.astro';
---
<Section class="contact" id="contact" labelledBy="contact-title">
  <div class="contact-background" aria-hidden="true">
    <video class="contact-background__video" muted loop playsinline preload="none" data-src="/videos/ocean2.mp4"></video>
  </div>
  <div class="contact-topline"><span>06 / CONTACT</span><span>THANKS FOR STOPPING BY</span></div>
  <div class="contact-layout">
    <div class="contact-heading">
      <h2 id="contact-title">Hello<span>.</span></h2>
      <p>Thanks for taking a look around.<br />You can find me here ↓</p>
    </div>
    <div class="contact-details" aria-label="Contact links">
      <a class="contact-row" href="mailto:sreejita_saha@outlook.com"><span><small>EMAIL</small><strong>sreejita_saha@outlook.com</strong></span><ArrowUpRight size={20} aria-hidden="true" /></a>
      <a class="contact-row" href="https://www.linkedin.com/in/sreejita-s"><span><small>CONNECT</small><strong>LinkedIn</strong></span><ArrowUpRight size={20} aria-hidden="true" /></a>
      <a class="contact-row" href="https://github.com/sreejita-saha"><span><small>MORE WORK</small><strong>GitHub</strong></span><ArrowUpRight size={20} aria-hidden="true" /></a>
      <a class="contact-row" href="/docs/Sreejita_Saha_CV.pdf" download><span><small>DOWNLOAD</small><strong>My CV <span class="contact-row__format">PDF</span></strong></span><Download size={19} aria-hidden="true" /></a>
    </div>
  </div>
  <footer class="contact-footer"><span>© SREEJITA / 2026</span><a href="#top">BACK TO TOP <ArrowUp size={13} aria-hidden="true" /></a></footer>
</Section>

<script>
  const video = document.querySelector<HTMLVideoElement>('.contact-background__video');
  const section = document.querySelector<HTMLElement>('#contact');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && section) {
    let visible = false;
    const update = () => {
      if (!visible || reducedMotion.matches || document.hidden) {
        video.pause();
        return;
      }
      if (!video.src && video.dataset.src) video.src = video.dataset.src;
      void video.play().catch(() => {});
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        visible = entries.some(entry => entry.isIntersecting);
        update();
      }, { rootMargin: '200px' });
      observer.observe(section);
    } else {
      visible = true;
      update();
    }
    reducedMotion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
  }
</script>
