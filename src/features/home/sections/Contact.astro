    <div class="contact-details" aria-label="Contact links">
      <a class="contact-row" href="mailto:sreejita_saha@outlook.com"><span><small>EMAIL</small><strong>sreejita_saha@outlook.com</strong></span><ArrowUpRight size={20} aria-hidden="true" /></a>
      <a class="contact-row" href="https://www.linkedin.com/in/sreejita-s"><span><small>CONNECT</small><strong>LinkedIn</strong></span><ArrowUpRight size={20} aria-hidden="true" /></a>
      <a class="contact-row" href="https://github.com/sreejita-saha"><span><small>MORE WORK</small><strong>GitHub</strong></span><ArrowUpRight size={20} aria-hidden="true" /></a>
